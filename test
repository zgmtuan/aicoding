private static boolean isPermanentFailure(MailSendException ex) {
    List<Throwable> roots = new ArrayList<>(List.of(ex.getMessageExceptions()));
    if (ex.getCause() != null) {
        roots.add(ex.getCause());
    }
    for (Throwable root : roots) {
        for (Throwable t = root; t != null; t = t.getCause()) {
            if (t instanceof SMTPAddressFailedException a && a.getReturnCode() >= 500) {
                return true;
            }
            if (t instanceof SMTPSendFailedException s && s.getReturnCode() >= 500) {
                return true;
            }
        }
    }
    return false;
}
